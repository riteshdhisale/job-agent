# Copy to .env (or export directly) and fill in real values.
# You only need ONE of ANTHROPIC_API_KEY / GEMINI_API_KEY -- pick whichever engine
# you want to run with --engine claude / --engine gemini. --engine fake needs neither.

# Required for --engine claude. Pay-as-you-go billing (needs credits in
# Anthropic Console > Plans & Billing before any request will work).
# Get one at https://console.anthropic.com/settings/keys -- when creating it,
# set Scope to a specific workspace (e.g. "Default"), not "Same as linked
# account", or requests will fail asking for a workspace id.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default Claude model. Check
# https://docs.claude.com/en/docs/about-claude/models for current model IDs.
# CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Required for --engine gemini. Has a genuine free tier for personal-scale use.
# Get one at https://aistudio.google.com/apikey -- NOTE: a personal Gemini Pro /
# Gemini Advanced app subscription (via Google One) does NOT include API access;
# this is a separate, free-to-start key.
GEMINI_API_KEY=

# Optional: override the default Gemini model. Default is gemini-3.5-flash-lite
# -- Flash-Lite models are built for exactly what this codebase does with Gemini
# (high-volume extraction/scoring, not open-ended reasoning), and full Flash
# models have live-confirmed problems as of Sept 2026: gemini-2.5-flash and
# gemini-2.5-flash-lite both 404 for new API keys ("no longer available to new
# users"), and gemini-3.6-flash works but had a very tight free-tier daily
# request cap (20/day observed live on a fresh project -- see README). If the
# default below ever 404s for you too, check
# https://ai.google.dev/gemini-api/docs/models for whatever Google currently
# points new users toward.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional, only needed for `cli.py contacts`. Free tier (75 lookups/month)
# is enough to try this. Sign up at https://www.apollo.io
APOLLO_API_KEY=

# Optional but recommended for `discover` -- without these, Adzuna is
# silently skipped (you'll see "ADZUNA_APP_ID/ADZUNA_APP_KEY not set" in the
# skipped/failed list) and you're relying on career_sites.json + RemoteOK +
# Greenhouse/Lever alone. Free, ~1,000 calls/month. Sign up at
# https://developer.adzuna.com, create an app, and copy both values below --
# this is the single biggest lever for finding "every 90%+ match" instead of
# just what's on a handful of hand-picked career pages.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
